# Environment Configuration Template
# Copy this file to .env and fill in your values

# Server Configuration
# Unprivileged: the container entrypoint drops root before vastiva binds
# this, and only root/CAP_NET_BIND_SERVICE can bind <1024 (#37). Map
# whatever host port you want in docker-compose.yml's "ports:" instead.
PORT=8080
SOURCE_DIR=/storage
DEST_DIR=/output

# GPU Configuration (nvidia, intel, amd, cpu)
GPU_VENDOR=cpu

# AI Provider Configuration
# Options: openai, claude, gemini, ollama, none
AI_PROVIDER=none
AI_API_KEY=
AI_ENDPOINT=
AI_MODEL=

# Security
ADMIN_PASSWORD=changeme
LICENSE_KEY=

# Reintegration
# With REPLACE_IN_PLACE=true a validated transcode takes its source's position
# in the library, so the media server sees the optimised file without anything
# being moved by hand. The original is MOVED to HOLDING_DIR, never deleted, so
# a bad batch can be reversed by moving that directory back. Replacement is
# skipped entirely unless HOLDING_DIR is set.
REPLACE_IN_PLACE=false
HOLDING_DIR=/storage/.vastiva-replaced

# File ownership for everything written (linuxserver convention, matching the
# Jellyfin container). The container process runs as this exact uid:gid
# (dropped from root by the entrypoint at startup, #37) rather than writing
# as some other user and chowning after the fact, so output is correctly
# owned from the moment it's created. Leave unset or -1 for a fixed,
# non-root 1000:1000 not matched to any host user.
PUID=1000
PGID=1000

# Scanner Configuration
SCANNER_ENABLED=false
SCANNER_MODE=manual
SCANNER_PROCESSED_FILE=/data/processed.json

# Persistence paths (all state written under /data — mount as a Docker volume)
JOBS_FILE=/data/jobs.json
SCANNER_CONFIG_FILE=/data/scanner-config.json

# CORS — space or comma-separated list of allowed origins.
# Set this to your domain in production (e.g. https://media.example.com).
# Defaults to localhost dev origins when unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# GitLab Container Registry (for deployment)
CI_REGISTRY_IMAGE=ghcr.io/vasteva/mediaconverter
CI_REGISTRY_USER=
CI_REGISTRY_PASSWORD=

# Deployment SSH Configuration
DEPLOY_HOST=server.vasteva.net
DEPLOY_USER=root
SSH_PRIVATE_KEY=
